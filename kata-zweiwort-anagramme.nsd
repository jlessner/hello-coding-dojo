    "intro" : {
      "areas" : [ "java.util.ArrayList", [ [ "specman.model.v001.TextEditAreaModel_V001", {
        "text" : "<html>\n  <head>\n    \n  </head>\n  <body>\n    <h1>\n      F<span style=\"background-color: rgba(255, 255, 255, 0.0)\"><font color=\"#000000\">inde \n      Zweiwort-Anagramme</font></span>\n    </h1>\n    <h2>\n      <span style=\"background-color: rgba(255, 255, 255, 0.0)\"><font color=\"#000000\">Beschreibung</font></span><font color=\"#000000\"><span style=\"background-color: rgba(255, 255, 255, 0.0)\"> \n      </span></font>\n    </h2>\n    <div>\n      <span style=\"background-color: rgba(255, 255, 255, 0.0)\"><font color=\"#000000\">Dieser \n      Usecase findet alle Zweiwort-Anagramme des Wortes &#8222;documenting&#8220;, \n      basierend auf einem Vokabular, das als Datei vorliegt. </font></span><font color=\"#000000\"><span style=\"background-color: rgba(255, 255, 255, 0.0)\">Ein \n      Zweiwort-Anagramm ist eine Kombination aus zwei </span><span style=\"background-color: rgba(255, 255, 255, 0.0)\">W&#246;rtern</span><span style=\"background-color: rgba(255, 255, 255, 0.0)\">, \n      die aus einer beliebigen Anordnung der Buchstaben des Wortes \n      &#8220;documenting&#8221; gebildet werden k&#246;nnen. </span><span style=\"background-color: rgba(255, 255, 255, 0.0)\">Beispiel: \n      Die </span><span style=\"background-color: rgba(255, 255, 255, 0.0)\">W&#246;rter</span><span style=\"background-color: rgba(255, 255, 255, 0.0)\"> \n      &#8220;document&#8221; and &#8220;gin&#8221; sind ein Zweiwort-Anagramm von &#8220;documenting&#8221;</span><span style=\"background-color: rgba(255, 255, 255, 0.0)\">.</span></font>\n    </div>\n    <h2>\n      <span style=\"background-color: rgba(255, 255, 255, 0.0)\"><font color=\"#000000\">Spezifikation</font></span><font color=\"#000000\"><span style=\"background-color: rgba(255, 255, 255, 0.0)\"> \n      </span></font>\n    </h2>\n  </body>\n</html>\n",
        "plainText" : "\nFinde Zweiwort-Anagramme\nBeschreibung \nDieser Usecase findet alle Zweiwort-Anagramme des Wortes „documenting“, basierend auf einem Vokabular, das als Datei vorliegt. Ein Zweiwort-Anagramm ist eine Kombination aus zwei Wörtern, die aus einer beliebigen Anordnung der Buchstaben des Wortes “documenting” gebildet werden können. Beispiel: Die Wörter “document” and “gin” sind ein Zweiwort-Anagramm von “documenting”.\nSpezifikation ",
        "markups" : [ "java.util.ArrayList", [ ] ],
        "aenderungsart" : "Untracked"
      } ] ] ]
    },
    "outro" : {
      "areas" : [ "java.util.ArrayList", [ [ "specman.model.v001.TextEditAreaModel_V001", {
        "text" : "<html>\n  <head>\n    \n  </head>\n  <body>\n    <div>\n      \n    </div>\n    <h2>\n      N<span style=\"background-color: rgba(255, 255, 255, 0.0)\"><font color=\"#000000\">ichtfunktionale \n      Anforderungen</font></span>\n    </h2>\n    <div>\n      <span style=\"background-color: rgba(255, 255, 255, 0.0)\"><font color=\"#000000\">Das \n      Vokabular kann eine 6-stellige Anzahl an W&#246;rtern enthalten. Das \n      Suchverfahren ist daher entsprechend optimiert, da der intuitive Ansatz \n      einer Bildung aller Wortpaare zu ineffizient w&#228;re.</font></span>\n    </div>\n  </body>\n</html>\n",
        "plainText" : "\n\nNichtfunktionale Anforderungen\nDas Vokabular kann eine 6-stellige Anzahl an Wörtern enthalten. Das Suchverfahren ist daher entsprechend optimiert, da der intuitive Ansatz einer Bildung aller Wortpaare zu ineffizient wäre.",
        "markups" : [ "java.util.ArrayList", [ ] ],
        "aenderungsart" : "Untracked"
      } ] ] ]
    },
