    "intro" : {
      "areas" : [ "java.util.ArrayList", [ [ "specman.model.v001.TextEditAreaModel_V001", {
        "text" : "<html>  <head>      </head>  <body>    <h1 margin-top=\"0\" resolver=\"NamedStyle:default {name=default,FONT_ATTRIBUTE_KEY=java.awt.Font[family=Sitka Display,name=Sitka Display,style=plain,size=15],}\">      <span style=\"background-color: rgba(255, 255, 255, 0.0)\"><font color=\"#000000\">Kata       &quot;Social Time&quot;</font></span>    </h1>    <p margin-top=\"0\" resolver=\"NamedStyle:default {name=default,FONT_ATTRIBUTE_KEY=java.awt.Font[family=Sitka Display,name=Sitka Display,style=plain,size=15],}\">      <span style=\"background-color: rgba(255, 255, 255, 0.0)\"><font color=\"#000000\">Postings       in a social media platform should not be displayed with date/time of       their creation but by their age. This usecase defines the business logic       to display the age, given as a period of seconds in a reader-friendly       style.</font></span>    </p>  </body></html>",
        "plainText" : "\nKata \"Social Time\"\nPostings in a social media platform should not be displayed with date/time of their creation but by their age. This usecase defines the business logic to display the age, given as a period of seconds in a reader-friendly style.",
